            "text": "{\"page\":1,\"results\":[{\"adult\":false,\"backdrop_path\":\"/gaew60NXUxok3Vmls7gkAT7lYW0.jpg\",\"id\":299939,\"name\":\"Monster: The Lizzie Borden Story\",\"original_name\":\"Monster: The Lizzie Borden Story\",\"overview\":\"Trapped in a cruel Victorian-era household, Lizzie Borden kills her parents in a gory ax murder that shocks the nation.\",\"poster_path\":\"/57XScX1aYtKi1LvHYFQLPUxVhTG.jpg\",\"media_type\":\"tv\",\"original_language\":\"en\",\"genre_ids\":[18,80],\"popularity\":165.6148,\"first_air_date\":\"2026-09-17\",\"softcore\":false,\"vote_average\":6.9,\"vote_count\":81,\"origin_country\":[\"US\"]},{\"adult\":false,\"backdrop_path\":\"/h0OC7ouop8YLwbAVfS3UUE2Lw4T.jpg\",\"id\":247718,\"name\":\"MobLand\",\"original_name\":\"MobLand\",\"overview\":\"Two mob families clash in a war that threatens to topple empires and lives.\",\"poster_path\":\"/5Xc7WpWsgflfgEMoBlf9TmWhfbH.jpg\",\"media_type\":\"tv\",\"original_language\":\"en\",\"genre_ids\":[80,18],\"popularity\":255.9333,\"first_air_date\":\"2025-03-30\",\"softcore\":false,\"vote_average\":8.4,\"vote_count\":886,\"origin_country\":[\"GB\",\"US\"]},{\"adult\":false,\"backdrop_path\":\"/uYOYLFQ4q7asuhdiKXCqGaeAQUH.jpg\",\"id\":273207,\"name\":\"Neagley\",\"original_name\":\"Neagley\",\"overview\":\"Frances Neagley is a private investigator in Chicago and former military colleague of Jack Reacher in the Army's 110th Special Investigations Unit. When she learns that a beloved friend from her past has been killed in a suspicious accident, she becomes hell-bent on justice.\",\"poster_path\":\"/tEPDFIa21VK0Q2YLuzhTt2xrw5W.jpg\",\"media_type\":\"tv\",\"original_language\":\"en\",\"genre_ids\":[18,9648,80],\"popularity\":164.7382,\"first_air_date\":\"2026-09-16\",\"softcore\":false,\"vote_average\":8.061,\"vote_count\":115,\"origin_country\":[\"US\"]},{\"adult\":false,\"backdrop_path\":\"/pF0qkRsrHkdYadPWY9AMeFZfcwk.jpg\",\"id\":108978,\"name\":\"Reacher\",\"original_name\":\"Reacher\",\"overview\":\"Jack Reacher, a veteran military police investigator, has just recently entered civilian life. Reacher is a drifter, carrying no phone and the barest of essentials as he travels the country and explores the nation he once served.\",\"poster_path\":\"/f1VCQIG2iCyOookdgOzwtUpwWC0.jpg\",\"media_type\":\"tv\",\"original_language\":\"en\",\"genre_ids\":[10759,80],\"popularity\":832.6872,\"first_air_date\":\"2022-02-03\",\"softcore\":false,\"vote_average\":8.128,\"vote_count\":3390,\"origin_country\":[\"US\"]},{\"adult\":false,\"backdrop_path\":\"/wJjnJbVUwPz0GADAgpFt9nWtzUu.jpg\",\"id\":95350,\"name\":\"Lanterns\",\"original_name\":\"Lanterns\",\"overview\":\"Two intergalactic cops, new recruit John Stewart and Lantern legend Hal Jordan, are drawn into a dark, Earth-based mystery as they investigate a murder in the American heartland.\",\"poster_path\":\"/gpC7h43xPMEV3goYMQShfJbTtLq.jpg\",\"media_type\":\"tv\",\"original_language\":\"en\",\"genre_ids\":[18,9648,10765],\"popularity\":276.6365,\"first_air_date\":\"2026-08-16\",\"softcore\":false,\"vote_average\":8.243,\"vote_count\":415,\"origin_country\":[\"US\"]},{\"adult\":false,\"backdrop_path\":\"/mU7l9UaEItxHbg2YBNs0sHjoFVY.jpg\",\"id\":113962,\"name\":\"Lioness\",\"original_name\":\"Lioness\",\"overview\":\"Cruz Manuelos, a rough-around-the-edges but passionate young Marine, is recruited to join the CIA's Lioness Engagement Team to help bring down a terrorist organization from within. Joe, the station chief of the Lioness program, is tasked with training, managing and leading her female undercover operatives.\",\"poster_path\":\"/rzpHPSEgPTpRs8EHbygwsOw7jC0.jpg\",\"media_type\":\"tv\",\"original_language\":\"en\",\"genre_ids\":[18,10768],\"popularity\":536.134,\"first_air_date\":\"2023-07-23\",\"softcore\":false,\"vote_average\":8.235,\"vote_count\":1615,\"origin_country\":[\"US\"]},{\"adult\":false,\"backdrop_path\":\"/uc1p1PEbEMpdIHqnU9TESNC6Jhp.jpg\",\"id\":275102,\"name\":\"The Scandal\",\"original_name\":\"스캔들\",\"overview\":\"In Joseon, a secret proposal ignites hidden desires in a gifted noblewoman, a famed lover and an unsuspecting lady caught in their dangerous game.\",\"poster_path\":\"/4TU0PcHBIl0wPW5B6aVRGExOnHE.jpg\",\"media_type\":\"tv\",\"original_language\":\"ko\",\"genre_ids\":[18],\"popularity\":3190.8628,\"first_air_date\":\"2026-09-18\",\"softcore\":false,\"vote_average\":6.6,\"vote_count\":12,\"origin_country\":[\"KR\"]},{\"adult\":false,\"backdrop_path\":\"/xpSxYoqTyz0Fb8Wn2S3bp0NIqVc.jpg\",\"id\":95480,\"name\":\"Slow Horses\",\"original_name\":\"Slow Horses\",\"overview\":\"Follow a dysfunctional team of MI5 agents—and their obnoxious boss, the notorious Jackson Lamb—as they navigate the espionage world's smoke and mirrors to defend England from sinister forces.\",\"poster_path\":\"/AdYr4DjOgXvDUMwu6vEhZy1Rnxk.jpg\",\"media_type\":\"tv\",\"original_language\":\"en\",\"genre_ids\":[80,18,9648],\"popularity\":155.2859,\"first_air_date\":\"2022-04-01\",\"softcore\":false,\"vote_average\":8.0,\"vote_count\":995,\"origin_country\":[\"GB\"]},{\"adult\":false,\"backdrop_path\":\"/3UviYOlhn8EgXMBuiT6MnUuo1w9.jpg\",\"id\":2190,\"name\":\"South Park\",\"original_name\":\"South Park\",\"overview\":\"Follow the misadventures of four irreverent grade-schoolers in the quiet, dysfunctional town of South Park, Colorado.\",\"poster_path\":\"/k7n2EVge7G77eMr3brztRGG1fFU.jpg\",\"media_type\":\"tv\",\"original_language\":\"en\",\"genre_ids\":[16,35],\"popularity\":140.333,\"first_air_date\":\"1997-08-13\",\"softcore\":false,\"vote_average\":8.332,\"vote_count\":5160,\"origin_country\":[\"US\"]},{\"adult\":false,\"backdrop_path\":\"/3yoTM5JtkxnPZvVzQOrL0c2ILVM.jpg\",\"id\":232018,\"name\":\"Has Fallen\",\"original_name\":\"Has Fallen\",\"overview\":\"A protection officer and an MI6 operative team up after a terrorist attack. They suspect a mole as they race to thwart a larger conspiracy threatening Paris.\",\"poster_path\":\"/eyK6fy2NWfjmyBjUvRAR14FynPK.jpg\",\"media_type\":\"tv\",\"original_language\":\"fr\",\"genre_ids\":[10759,10768],\"popularity\":55.2437,\"first_air_date\":\"2024-09-23\",\"softcore\":false,\"vote_average\":7.0,\"vote_count\":124,\"origin_country\":[\"FR\"]},{\"adult\":false,\"backdrop_path\":\"/nE94ejEbzNCU48bW1oju0dqBONz.jpg\",\"id\":97546,\"name\":\"Ted Lasso\",\"original_name\":\"Ted Lasso\",\"overview\":\"Ted Lasso, an American football coach, moves to England when he's hired to manage a soccer team—despite having no experience. With cynical players and a doubtful town, will he get them to see the Ted Lasso Way?\",\"poster_path\":\"/uRHsiw1wLxPHFXkkv4Ix1s0O6f4.jpg\",\"media_type\":\"tv\",\"original_language\":\"en\",\"genre_ids\":[18,35],\"popularity\":229.6314,\"first_air_date\":\"2020-08-14\",\"softcore\":false,\"vote_average\":8.372,\"vote_count\":2682,\"origin_country\":[\"US\"]},{\"adult\":false,\"backdrop_path\":\"/icPBB9V5IX1hggtNs1fvskP2lsi.jpg\",\"id\":332401,\"name\":\"City of Blood\",\"original_name\":\"City of Blood\",\"overview\":\"Berlin — a city-state on the brink. While a privileged few live beneath a climate-controlled dome, those outside struggle to survive in a world ravaged by heat, corruption, and crime. After years apart, sisters Bea and Phoebe are reunited and uncover a dark secret: Vampires are determined to seize political power — and blood has become the city's new currency.\",\"poster_path\":\"/Njr0Rlb4CobAfrGE8NVffYDGqx.jpg\",\"media_type\":\"tv\",\"original_language\":\"de\",\"genre_ids\":[9648],\"popularity\":46.2183,\"first_air_date\":\"2026-09-16\",\"softcore\":false,\"vote_average\":6.4,\"vote_count\":14,\"origin_country\":[\"DE\"]},{\"adult\":false,\"backdrop_path\":\"/t708JUdkHAoZF83f4RjqcIGrJ99.jpg\",\"id\":239618,\"name\":\"American Hostage\",\"original_name\":\"American Hostage\",\"overview\":\"A psychological thriller anthology series focusing on a different hostage case every season.\",\"poster_path\":\"/cJX6cFqJsX4cWe3DeZBJzg7w4rH.jpg\",\"media_type\":\"tv\",\"original_language\":\"en\",\"genre_ids\":[80,18],\"popularity\":42.0913,\"first_air_date\":\"2026-09-20\",\"softcore\":false,\"vote_average\":7.2,\"vote_count\":5,\"origin_country\":[\"US\"]},{\"adult\":false,\"backdrop_path\":\"/2rmK7mnchw9Xr3XdiTFSxTTLXqv.jpg\",\"id\":37854,\"name\":\"One Piece\",\"original_name\":\"ワンピース\",\"overview\":\"Years ago, the fearsome Pirate King, Gol D. Roger was executed leaving a huge pile of treasure and the famous \\\"One Piece\\\" behind. Whoever claims the \\\"One Piece\\\" will be named the new King of the Pirates.\\n\\nMonkey D. Luffy, a boy who consumed a \\\"Devil Fruit,\\\" decides to follow in the footsteps of his idol, the pirate Shanks, and find the One Piece. It helps, of course, that his body has the properties of rubber and that he's surrounded by a bevy of skilled fighters and thieves to help him along the way.\\n\\nLuffy will do anything to get the One Piece and become King of the Pirates!\",\"poster_path\":\"/dB4EDhre2dsC2kxYDavyKWqLQwi.jpg\",\"media_type\":\"tv\",\"original_language\":\"ja\",\"genre_ids\":[10759,35,16],\"popularity\":91.1794,\"first_air_date\":\"1999-10-20\",\"softcore\":false,\"vote_average\":8.749,\"vote_count\":5554,\"origin_country\":[\"JP\"]},{\"adult\":false,\"backdrop_path\":\"/7ZruEnSnHD6Jx5mF0hBt1E306Vt.jpg\",\"id\":65942,\"name\":\"Re:ZERO -Starting Life in Another World-\",\"original_name\":\"Re:ゼロから始める異世界生活\",\"overview\":\"Natsuki Subaru, an ordinary high school  student, is on his way home from the convenience store when he finds  himself transported to another world. As he's lost and confused in a new  world where he doesn't even know left from right, the only person to  reach out to him was a beautiful girl with silver hair. Determined to  repay her somehow for saving him from his own despair, Subaru agrees to  help the girl find something she's looking for.\",\"poster_path\":\"/oHqYrPAsIiTD5m4DuxumV4er8BU.jpg\",\"media_type\":\"tv\",\"original_language\":\"ja\",\"genre_ids\":[16,9648,10759,10765],\"popularity\":160.5247,\"first_air_date\":\"2016-04-04\",\"softcore\":false,\"vote_average\":8.1,\"vote_count\":787,\"origin_country\":[\"JP\"]},{\"adult\":false,\"backdrop_path\":\"/j9fRIimor0AMFJR9kjZubXcABzZ.jpg\",\"id\":94664,\"name\":\"Mushoku Tensei: Jobless Reincarnation\",\"original_name\":\"無職転生 ～異世界行ったら本気だす～\",\"overview\":\"When a 34-year-old underachiever gets run over by a truck, his story doesn't end there. Reincarnated in a new world as an infant, Rudy will seize every opportunity to live the life he's always wanted. Armed with new friends, some freshly acquired magical abilities, and the courage to do the things he's always dreamed of, he's embarking on an epic adventure—with all of his past experience intact!\",\"poster_path\":\"/1mFnzilCyj9Coa9jbN8vFYLEZdW.jpg\",\"media_type\":\"tv\",\"original_language\":\"ja\",\"genre_ids\":[10759,16,10765],\"popularity\":275.1399,\"first_air_date\":\"2021-01-11\",\"softcore\":false,\"vote_average\":8.414,\"vote_count\":1729,\"origin_country\":[\"JP\"]},{\"adult\":false,\"backdrop_path\":\"/ulBGaxq9GmJexyEOi4Xci74g6Vt.jpg\",\"id\":224263,\"name\":\"Stranger Things: Tales from '85\",\"original_name\":\"Stranger Things: Tales from '85\",\"overview\":\"Winter. Hawkins. 1985. Welcome back to a town crawling with secrets, where beloved heroes are facing fresh mysteries... and an all-new breed of strange.\",\"poster_path\":\"/xyVpiSZNA2fYJUuuagkqiSHJqjr.jpg\",\"media_type\":\"tv\",\"original_language\":\"en\",\"genre_ids\":[16,10765,9648,10759],\"popularity\":49.4126,\"first_air_date\":\"2026-04-23\",\"softcore\":false,\"vote_average\":7.639,\"vote_count\":108,\"origin_country\":[\"US\"]},{\"adult\":false,\"backdrop_path\":\"/o0NsbcIvsllg6CJX0FBFY8wWbsn.jpg\",\"id\":30984,\"name\":\"Bleach\",\"original_name\":\"BLEACH\",\"overview\":\"For as long as he can remember, Ichigo Kurosaki has been able to see ghosts. But when he meets Rukia, a Soul Reaper who battles evil spirits known as Hollows, he finds his life is changed forever. Now, with a newfound wealth of spiritual energy, Ichigo discovers his true calling: to protect the living and the dead from evil.\",\"poster_path\":\"/2EewmxXe72ogD0EaWM8gqa0ccIw.jpg\",\"media_type\":\"tv\",\"original_language\":\"ja\",\"genre_ids\":[10759,16,10765],\"popularity\":208.5297,\"first_air_date\":\"2004-10-05\",\"softcore\":false,\"vote_average\":8.35,\"vote_count\":2277,\"origin_country\":[\"JP\"]},{\"adult\":false,\"backdrop_path\":\"/aLE7R8QZPpTiWZS48PS22i2OWbl.jpg\",\"id\":250203,\"name\":\"Brothers\",\"original_name\":\"Brothers\",\"overview\":\"Hollywood actors Matthew McConaughey and Woody Harrelson have been best friends for years, but a shocking family secret suggests their connection might be closer.\",\"poster_path\":\"/jD7ZQpDEZzAVReJzkOtmuFoIl2m.jpg\",\"media_type\":\"tv\",\"original_language\":\"en\",\"genre_ids\":[35],\"popularity\":14.858,\"first_air_date\":\"2026-09-22\",\"softcore\":false,\"vote_average\":10.0,\"vote_count\":4,\"origin_country\":[\"US\"]},{\"adult\":false,\"backdrop_path\":\"/fQGrzO0Iwo7CO4b2zVdJLkcnhwK.jpg\",\"id\":125988,\"name\":\"Silo\",\"original_name\":\"Silo\",\"overview\":\"In a ruined and toxic future, thousands live in a giant silo deep underground. After its sheriff breaks a cardinal rule and residents die mysteriously, engineer Juliette starts to uncover shocking secrets and the truth about the silo.\",\"poster_path\":\"/gMYZZvnkVNTqSVnVCphWbPXwWwb.jpg\",\"media_type\":\"tv\",\"original_language\":\"en\",\"genre_ids\":[10765,18],\"popularity\":210.1226,\"first_air_date\":\"2023-05-04\",\"softcore\":false,\"vote_average\":8.2,\"vote_count\":2712,\"origin_country\":[\"US\"]}],\"total_pages\":500,\"total_results\":10000}"
